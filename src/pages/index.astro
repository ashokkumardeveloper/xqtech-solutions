---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const phone = "916235455560";
const phoneDisplay = "+91 6235455560";

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "XQ Tech Solutions",
    "url": "https://xqtechsolutions.in",
    "logo": "https://xqtechsolutions.in/images/qxtechlogo.png",
    "description": "XQ Tech Solutions builds powerful mobile applications for local businesses across India. From livestock management to e-commerce, we deliver solutions that work.",
    "email": "xqtechsolutions@gmail.com",
    "telephone": "+916235455560",
    "foundingLocation": "Palakkad, Kerala, India",
    "knowsAbout": ["Mobile App Development", "Flutter", "Firebase", "Web Development"],
    "sameAs": []
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "XQ Tech Solutions",
    "url": "https://xqtechsolutions.in",
    "email": "xqtechsolutions@gmail.com",
    "telephone": "+916235455560",
    "description": "Mobile app development company specializing in Flutter apps for local businesses in India.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Palakkad",
      "addressRegion": "Kerala",
      "addressCountry": "IN"
    },
    "priceRange": "$$",
    "areaServed": {
      "@type": "Country",
      "name": "India"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "XQ Tech Solutions",
    "url": "https://xqtechsolutions.in",
    "description": "Mobile app development company based in Palakkad, Kerala."
  }
]);

const apps = [
  {
    name: "Paal Pannai",
    category: "Livestock Management",
    desc: "Complete dairy farm management — track animals, milk production, health records, breeding cycles, feed nutrition, and finances all in one app.",
    color: "from-green-500 to-emerald-600",
    icon: "🐄",
    android: "https://play.google.com/store/apps/details?id=com.xqtechsolutions.paal_pannai&hl=en",
    web: "https://paal-pannai.web.app",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy/paal-pannai" },
      { label: "Terms", href: "/terms/paal-pannai" },
    ],
  },
  {
    name: "MyChoice Palakkad",
    category: "Local Fashion Discovery",
    desc: "Discover local clothing shops, browse products, contact via WhatsApp, earn cashback rewards, and leave reviews — all in one place.",
    color: "from-purple-500 to-pink-600",
    icon: "👗",
    android: "https://play.google.com/store/apps/details?id=com.xqtechsolutions.my_choice&hl=en",
    web: "https://mychoicepalakkad.in",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy/mychoice-palakkad" },
      { label: "Terms", href: "/terms/mychoice-palakkad" },
    ],
  },
  {
    name: "Field Fresh Milk",
    category: "Dairy Delivery & Vendor",
    desc: "Daily milk and dairy delivery for homes plus management for local vendors — track subscriptions, routes, deliveries, and payments in one app.",
    color: "from-sky-500 to-blue-700",
    icon: "🥛",
    android: "https://play.google.com/store/apps/details?id=com.xqtechsolutions.field_fresh_milk&hl=en",
    web: "https://field-fresh-milk.web.app/",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy/field-fresh-milk" },
      { label: "Terms", href: "/terms/field-fresh-milk" },
    ],
  },
  {
    name: "OnePlace",
    category: "Grocery & Delivery",
    desc: "One app, everything you need — order groceries, food, and essentials for delivery in Kozhinjampara, Palakkad and surrounding areas.",
    color: "from-orange-500 to-amber-600",
    icon: "🛒",
    android: "https://play.google.com/store/apps/details?id=com.xqtechsolution.oneplace_customer&hl=en",
    web: "https://oneplacedelivery.web.app",
    links: [
      { label: "Privacy Policy", href: "https://oneplacedelivery.in/privacy-policy", external: true },
      { label: "Terms", href: "https://oneplacedelivery.in/terms", external: true },
    ],
  },
];

const steps = [
  { n: "1", title: "Discover", desc: "We understand your business needs, workflows, and the problems your customers face." },
  { n: "2", title: "Design", desc: "UX-first design tailored for local users — simple, fast, and works on any Android or iOS device." },
  { n: "3", title: "Build", desc: "Flutter-powered cross-platform apps backed by Firebase for real-time data and offline reliability." },
  { n: "4", title: "Launch", desc: "App Store & Play Store publish, ongoing support, and feature updates as your business grows." },
];
---

<BaseLayout
  title="XQ Tech Solutions - Mobile App Development Company in Palakkad, Kerala"
  description="XQ Tech Solutions builds powerful mobile applications for local businesses across India. From livestock management to grocery delivery, we deliver Flutter apps that work."
  keywords="XQ Tech Solutions, mobile app development, Flutter app development, app development company India, mobile app development Palakkad, Kerala app developer, livestock management app, local business app, Paal Pannai, MyChoice Palakkad, Field Fresh Milk, OnePlace, grocery delivery app, milk delivery app, dairy delivery app, Kozhinjampara"
  schema={schema}
>
  <Header variant="dark" />

  <!-- Hero -->
  <section class="relative bg-primary text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary via-blue-950/40 to-accent/10"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-6 md:px-12 pt-20 pb-20 md:pt-28 md:pb-28">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-accent/20 border border-accent/40 rounded-full px-4 py-1.5 text-xs font-semibold text-accent-light mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-light animate-pulse"></span>
            PALAKKAD, KERALA · INDIA
          </div>
          <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
            Building Apps That<br />
            <span class="text-accent-light">Empower Local</span><br />
            Businesses
          </h1>
          <p class="text-gray-300 text-lg md:text-xl mb-8 leading-relaxed">
            We craft Flutter-powered mobile and web applications that solve real problems for businesses across India — from dairy farms to grocery delivery.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href={`tel:+${phone}`}
              class="flex items-center gap-3 bg-white text-primary hover:bg-accent hover:text-white font-semibold px-6 py-3.5 rounded-xl transition-colors"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div class="text-left leading-tight">
                <div class="text-[10px] uppercase tracking-widest opacity-80">CALL US NOW</div>
                <div class="font-bold">{phoneDisplay}</div>
              </div>
            </a>
            <a
              href={`https://wa.me/${phone}?text=Hi%2C%20I%20need%20a%20mobile%20app%20for%20my%20business`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-xl transition-colors"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <div class="text-left leading-tight">
                <div class="text-[10px] uppercase tracking-widest opacity-80">CHAT WITH US</div>
                <div class="font-bold">WhatsApp</div>
              </div>
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-5 mt-8 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-light" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>4+ Apps Live</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-light" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Flutter Powered</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-light" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Firebase Backed</span>
            </div>
          </div>
        </div>

        <!-- Hero visual -->
        <div class="hidden md:flex justify-center">
          <div class="relative w-full max-w-[360px]">
            <div class="bg-white/5 border border-white/10 backdrop-blur rounded-3xl p-6 space-y-4 shadow-2xl">
              <div class="flex items-center justify-between mb-2">
                <div class="text-sm font-bold text-white">Our Portfolio</div>
                <div class="text-[10px] uppercase tracking-widest text-accent-light font-semibold">Live Apps</div>
              </div>
              {apps.map((app) => (
                <div class="flex items-center gap-4 bg-white/10 rounded-2xl px-4 py-3">
                  <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${app.color} flex items-center justify-center text-xl flex-shrink-0`}>{app.icon}</div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-white truncate">{app.name}</div>
                    <div class="text-[11px] text-gray-400 truncate">{app.category}</div>
                  </div>
                  <div class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></div>
                </div>
              ))}
              <div class="pt-2 border-t border-white/10 flex items-center justify-between text-xs text-gray-400">
                <span>Android & iOS</span>
                <span class="text-accent-light font-semibold">Palakkad, Kerala</span>
              </div>
            </div>
            <div class="absolute -top-4 -right-4 bg-white text-primary rounded-2xl px-4 py-3 shadow-xl rotate-3">
              <div class="text-[10px] uppercase tracking-widest text-muted">Built with</div>
              <div class="font-bold text-base">Flutter</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-block bg-accent/10 border border-accent/20 rounded-full px-4 py-1.5 text-xs font-semibold text-accent mb-4">
          WHO WE ARE
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Built for Local, Built to Last</h2>
        <p class="text-muted max-w-2xl mx-auto text-lg">
          XQ Tech Solutions is a software development company based in Palakkad, Kerala. We specialize in Flutter-powered mobile apps that help local businesses digitize and grow.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-lg mb-2">Mobile First</h3>
          <p class="text-muted text-sm leading-relaxed">
            Cross-platform Flutter apps that work seamlessly on Android and iOS with a single codebase.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-lg mb-2">Local Focus</h3>
          <p class="text-muted text-sm leading-relaxed">
            Purpose-built solutions for Indian businesses — from farms and clinics to shops and delivery services.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-lg mb-2">Reliable & Secure</h3>
          <p class="text-muted text-sm leading-relaxed">
            Cloud-backed with Firebase — real-time sync, offline support, and data safety you can trust.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Apps -->
  <section id="apps" class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-block bg-accent/10 border border-accent/20 rounded-full px-4 py-1.5 text-xs font-semibold text-accent mb-4">
          OUR APPS
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Solutions Built for Real Business</h2>
        <p class="text-muted max-w-xl mx-auto text-lg">
          Each app is designed from scratch for a specific industry, with real workflows in mind.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {apps.map((app) => (
          <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all">
            <div class={`aspect-[4/3] relative bg-gradient-to-br ${app.color} flex items-center justify-center`}>
              <div class="text-7xl">{app.icon}</div>
              <div class="absolute top-4 right-4 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-white/90 text-gray-700">
                Live
              </div>
            </div>
            <div class="p-5">
              <div class="text-[10px] font-semibold uppercase tracking-widest text-muted mb-1">{app.category}</div>
              <h3 class="font-bold text-lg mb-2">{app.name}</h3>
              <p class="text-muted text-sm leading-relaxed mb-4">{app.desc}</p>
              <!-- Store buttons -->
              <div class="flex flex-col gap-2 mb-4">
                <a
                  href={app.android}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2.5 bg-primary hover:bg-accent text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors"
                >
                  <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/>
                  </svg>
                  <div class="leading-tight">
                    <div class="text-[9px] uppercase tracking-widest opacity-70">GET IT ON</div>
                    <div>Google Play</div>
                  </div>
                </a>
                <a
                  href={app.web}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2.5 bg-gray-100 hover:bg-accent hover:text-white text-primary text-xs font-semibold px-3 py-2 rounded-lg transition-colors"
                >
                  <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                  </svg>
                  <div class="leading-tight">
                    <div class="text-[9px] uppercase tracking-widest opacity-70">iOS / WEB</div>
                    <div>Open App</div>
                  </div>
                </a>
              </div>
              <!-- Legal links -->
              <div class="flex flex-wrap gap-2 text-xs border-t border-gray-100 pt-3">
                {app.links.map((link) => (
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="text-muted hover:text-accent transition-colors"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-block bg-accent/10 border border-accent/20 rounded-full px-4 py-1.5 text-xs font-semibold text-accent mb-4">
          OUR PROCESS
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">How We Build</h2>
        <p class="text-muted max-w-xl mx-auto text-lg">
          From idea to live app — a clear, collaborative process every step of the way.
        </p>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        {steps.map((step) => (
          <div class="text-center">
            <div class="w-16 h-16 bg-accent text-white rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-lg shadow-accent/30">{step.n}</div>
            <h3 class="font-bold text-lg mb-2">{step.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="relative bg-primary text-white py-20 px-6 overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    <div class="relative max-w-5xl mx-auto text-center">
      <div class="inline-block bg-accent/20 border border-accent/40 rounded-full px-4 py-1.5 text-xs font-semibold text-accent-light mb-6">
        GET IN TOUCH
      </div>
      <h2 class="text-3xl md:text-5xl font-extrabold mb-6">
        Have a Business Idea? <br /><span class="text-accent-light">Let's Build It.</span>
      </h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-10">
        Tell us about your business and what problem you want to solve. We'll help you figure out the right app for it.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a
          href={`tel:+${phone}`}
          class="flex items-center gap-3 bg-white text-primary hover:bg-accent hover:text-white font-semibold px-7 py-4 rounded-xl transition-colors"
