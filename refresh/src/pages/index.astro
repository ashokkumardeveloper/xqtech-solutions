---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const siteUrl = "https://refreshhealthy.in";
const xqUrl = "https://xqtechsolutions.in";
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.xqtechsolutions.refresh";
const webAppUrl = "https://eat-fit-healthy.web.app/";
const supportEmail = "xqtechsolutions@gmail.com";
const supportWhatsApp = "916235455560";
const supportWhatsAppDisplay = "+91 6235455560";

const seoKeywords = [
  "refresh app", "refresh healthy meals", "refresh gym meals", "refreshhealthy.in",
  "healthy meal delivery", "high protein meal delivery", "macro meals", "macro tracked meals",
  "gym meal delivery", "fitness meal delivery", "chef made healthy meals", "build your own meal app",
  "protein meals delivery", "clean eating delivery", "weighed portion meals", "macros on every meal",
  "healthy meal delivery palakkad", "gym food delivery palakkad", "protein meals palakkad",
  "eat like you train", "cloud kitchen healthy food", "cut meals", "bulk meals", "lean meal plan"
].join(", ");

const appSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "Refresh",
  "operatingSystem": "Android, iOS, Web",
  "applicationCategory": "HealthApplication",
  "description": "Refresh — chef-cooked healthy meals and build-your-own bowls, weighed to the gram with macros you can trust, delivered to your gym in time for training.",
  "url": siteUrl,
  "installUrl": playStoreUrl,
  "publisher": { "@type": "Organization", "name": "XQ Tech Solutions", "url": xqUrl },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
});

const faqs = [
  { q: "What is Refresh?", a: "Refresh is a healthy-meal app for people who train. Order chef-cooked meals or build your own bowl with live macros, then collect it at your gym. Every plate is weighed and comes with its full macro breakdown — protein, carbs, fat, and fiber." },
  { q: "How does delivery work?", a: "Meals are delivered to the front desk of the partner gym you select, timed to training slots so your food never sits in traffic. Order for specific days and slots up to 7 days ahead, and collect your box during your slot." },
  { q: "Can I match meals to my goal?", a: "Yes. Whether you're building muscle, cutting, staying lean, or training for endurance, filter meals by goal and build your own with the macro rings updating live as you go." },
  { q: "Can I trust the macros?", a: "Every portion is weighed to the gram in one cloud kitchen — no dark-kitchen roulette. The numbers on the app match the food in the box, and our kitchen is FSSAI-registered." },
  { q: "What payment methods are supported?", a: "Orders are paid in full at checkout via UPI, cards, and net banking through our secure provider, Razorpay. Your card details never touch our servers." },
  { q: "What if I need to cancel?", a: "Cancel any delivery day before its cutoff and the full amount is credited to your in-app wallet instantly — usable on orders, not withdrawable. After the cutoff the kitchen has already started cooking. If we ever fail you, that day is credited in full." }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
});

const combinedSchema = `${appSchema}</script><script type="application/ld+json">${faqSchema}`;

// Goal filter = the page spine. One tap re-skins the rail word, ticket, order line + bowl rings.
const goals = [
  { id: "muscle",    label: "Build Muscle", emoji: "💪", word: "train.",           tagline: "Surplus fuel, protein-forward.",      meal: "Double Chicken & Brown Rice", kcal: 720, protein: 58, carbs: 62, fat: 18, pP: 84, pC: 66, pF: 46, pFbr: 40 },
  { id: "cut",       label: "Lean & Cut",   emoji: "🔥", word: "cut.",             tagline: "High protein, lighter calories.",     meal: "Grilled Fish & Greens",       kcal: 430, protein: 44, carbs: 22, fat: 14, pP: 64, pC: 26, pF: 36, pFbr: 48 },
  { id: "maintain",  label: "Stay Lean",    emoji: "🥗", word: "stay lean.",       tagline: "Balanced plates for every day.",      meal: "Paneer Buddha Bowl",          kcal: 560, protein: 34, carbs: 48, fat: 20, pP: 50, pC: 54, pF: 62, pFbr: 58 },
  { id: "endurance", label: "Endurance",    emoji: "🏃", word: "go the distance.", tagline: "Clean carbs that go the distance.",  meal: "Sweet Potato & Egg Bowl",     kcal: 610, protein: 30, carbs: 74, fat: 16, pP: 44, pC: 90, pF: 40, pFbr: 66 },
];

const ingredients = [
  { name: "Brown rice", g: "180 g" },
  { name: "Grilled chicken", g: "160 g" },
  { name: "Greens & veg", g: "120 g" },
  { name: "House sauce", g: "30 g" },
];

const timetable = [
  { n: "01", action: "Pick your gym", detail: "Your training spot", time: "Set once" },
  { n: "02", action: "Choose or build", detail: "Chef meal or your bowl", time: "Live macros" },
  { n: "03", action: "Pay in full", detail: "UPI / card · Razorpay", time: "At checkout" },
  { n: "04", action: "Collect at the desk", detail: "Front desk, your slot", time: "In your slot" },
];

const ledger = [
  { you: "Cancel before cutoff", we: "Full amount to your wallet, instant.*" },
  { you: "Order 7 days ahead", we: "We cook against real orders each morning." },
  { you: "Pick one kitchen", we: "No dark-kitchen roulette. Same hands." },
  { you: "Read the macros", we: "Weighed to the gram, verified." },
];

const marqueeWords = ["High protein", "Macro-verified", "Chef-cooked", "Weighed to the gram", "Delivered to your gym", "No dark-kitchen roulette"];

const playSvg = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>`;
---

<BaseLayout
  title="Refresh - Eat Like You Train | Chef-Cooked, Macro-Verified Meals Delivered to Your Gym"
  description="Refresh — chef-cooked healthy meals and build-your-own bowls, weighed to the gram with macros you can trust, delivered to your gym in time for training. Fuel your goals."
  keywords={seoKeywords}
  schema={combinedSchema}
>
  <div class="lg:grid lg:grid-cols-[40%_60%] bg-forest">

    <!-- ================= FIXED LEFT RAIL — THE CONSOLE ================= -->
    <aside id="rail" class="bg-forest text-white lg:fixed lg:inset-y-0 lg:left-0 lg:w-[40%] flex flex-col justify-between gap-8 px-7 sm:px-10 lg:px-12 py-9 lg:py-10 min-h-[88vh] lg:min-h-screen overflow-hidden lg:overflow-y-auto" style="--rail-accent:#a7d94b">
      <!-- brand -->
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M32 46V30" stroke="#a7d94b" stroke-width="4" stroke-linecap="round"/>
              <path d="M32 32c0-7-5-12-13-13 0 8 5 13 13 13Z" fill="#4e9a3d"/>
              <path d="M32 28c0-6 4-11 12-12 0 7-5 12-12 12Z" fill="#3e9142"/>
            </svg>
          </span>
          <span class="font-bold tracking-tight text-lg" style="font-family: var(--font-display)">Refresh</span>
        </a>
        <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em]" style="border-color:color-mix(in srgb,var(--rail-accent) 40%,transparent);color:var(--rail-accent)">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:var(--rail-accent)"></span>FSSAI-registered
        </span>
      </div>

      <!-- anchor headline + subhead -->
      <div class="max-w-md">
        <h1 class="font-bold leading-[0.95] tracking-tight" style="font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4.6rem)">
          Eat like<br />you <span class="inline-block overflow-hidden align-bottom h-[1.05em]"><span id="goalWord" class="goal-word text-volt">train.</span></span>
        </h1>
        <p class="text-white/70 text-base md:text-lg mt-5 leading-relaxed">
          Chef-cooked meals and build-your-own bowls, weighed to the gram, collected at your gym
          in your slot.
        </p>
      </div>

      <!-- control block: goal filter + live ticket + CTAs -->
      <div class="space-y-5">
        <!-- goal filter -->
        <div>
          <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/45 mb-2.5">Choose your goal</div>
          <div id="goalFilter" role="radiogroup" aria-label="Choose your goal" class="grid grid-cols-2 gap-2">
            {goals.map((g, i) => (
              <button
                type="button"
                class={`goal-btn inline-flex items-center gap-2 rounded-xl border px-3 py-2.5 text-sm text-left transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-volt ${i === 0 ? "bg-volt text-forest border-volt font-bold" : "bg-white/5 text-white/85 border-white/15 font-semibold hover:border-white/40"}`}
                role="radio"
                aria-checked={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-goal={g.id}
              >
                <span aria-hidden="true">{g.emoji}</span>{g.label}
              </button>
            ))}
          </div>
        </div>

        <!-- live order ticket (gym-desk receipt) -->
        <div class="relative rounded-2xl bg-surface text-ink p-4 sm:p-5" style="background-image:radial-gradient(circle at 9px -5px, transparent 6px, var(--color-surface) 6px); background-size:18px 100%">
          <div class="flex items-center justify-between mb-3">
            <span class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-muted">
              <span class="w-1.5 h-1.5 rounded-full bg-clay animate-pulse"></span>Today's box · live
            </span>
            <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted">weighed</span>
          </div>
          <div class="text-lg sm:text-xl font-bold text-primary mb-4 leading-tight" style="font-family: var(--font-display)" data-refresh-meal>Double Chicken & Brown Rice</div>
          <div class="grid grid-cols-3 gap-3 mb-4">
            <div class="text-center">
              <div class="macro-ring mx-auto w-12 h-12 rounded-full grid place-items-center" data-ring="p" style="--p:84%; background: conic-gradient(var(--color-clay) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-8 h-8 rounded-full bg-white grid place-items-center text-[11px] font-bold tabular-nums text-clay"><span data-refresh-p>58</span>g</span>
              </div>
              <div class="text-[10px] font-semibold text-muted mt-1">Protein</div>
            </div>
            <div class="text-center">
              <div class="macro-ring mx-auto w-12 h-12 rounded-full grid place-items-center" data-ring="c" style="--p:66%; background: conic-gradient(var(--color-honey) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-8 h-8 rounded-full bg-white grid place-items-center text-[11px] font-bold tabular-nums text-honey"><span data-refresh-c>62</span>g</span>
              </div>
              <div class="text-[10px] font-semibold text-muted mt-1">Carbs</div>
            </div>
            <div class="text-center">
              <div class="macro-ring mx-auto w-12 h-12 rounded-full grid place-items-center" data-ring="f" style="--p:46%; background: conic-gradient(var(--color-teal) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-8 h-8 rounded-full bg-white grid place-items-center text-[11px] font-bold tabular-nums text-teal"><span data-refresh-f>18</span>g</span>
              </div>
              <div class="text-[10px] font-semibold text-muted mt-1">Fat</div>
            </div>
          </div>
          <div class="flex items-center justify-between rounded-xl bg-forest text-white px-3.5 py-2.5">
            <div class="leading-tight">
              <div class="text-[10px] uppercase tracking-[0.16em] text-volt">Total energy</div>
              <div class="font-bold tabular-nums" style="font-family: var(--font-display)"><span data-refresh-kcal>720</span> kcal</div>
            </div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-volt border border-volt/40 rounded px-2 py-1 -rotate-3">weighed</span>
          </div>
        </div>

        <!-- install CTAs -->
        <div class="flex flex-col sm:flex-row gap-2.5">
          <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" set:html={`${playSvg}<span>Google Play</span>`}
             class="flex-1 flex items-center justify-center gap-2.5 bg-volt text-forest font-bold px-4 py-3 rounded-full hover:brightness-105 transition"></a>
          <a href={webAppUrl} target="_blank" rel="noopener noreferrer"
             class="flex-1 flex items-center justify-center gap-2 border border-white/25 bg-white/5 hover:bg-white/12 text-white font-semibold px-4 py-3 rounded-full transition-colors">Web app →</a>
        </div>
      </div>
    </aside>

    <!-- ================= SCROLLING RIGHT COLUMN ================= -->
    <main class="lg:col-start-2">

      <!-- Screen 01 · THE ORDER (dark, seamless with rail) -->
      <section data-accent="#a7d94b" class="bg-forest text-white min-h-screen flex flex-col justify-center relative overflow-hidden px-7 sm:px-10 lg:px-16 py-24">
        <div aria-hidden="true" class="pointer-events-none select-none absolute -right-4 top-8 text-outline text-white/[0.05] font-semibold leading-none" style="font-family: var(--font-display); font-size: clamp(6rem, 14vw, 15rem)">FUEL</div>
        <div class="relative max-w-2xl">
          <div class="grid grid-cols-4 gap-3 text-[10px] font-bold uppercase tracking-[0.16em] text-volt/80 border-b border-white/10 pb-3 mb-4">
            <span>Slot</span><span>Gym</span><span>Goal</span><span class="text-right">Total</span>
          </div>
          <div class="grid grid-cols-4 gap-3 text-sm font-semibold tabular-nums pb-8 mb-2">
            <span>6:30 pm</span><span>Your gym</span><span data-refresh-goal>Build Muscle</span><span class="text-right"><span data-refresh-kcal>720</span> kcal</span>
          </div>
          <h2 class="font-bold leading-[0.98] tracking-tight mb-6" style="font-family: var(--font-display); font-size: clamp(2.4rem, 5.5vw, 4.25rem)">
            Your box is <span class="text-volt">weighed</span><br />before it's yours.
          </h2>
          <p class="text-white/70 text-lg max-w-xl leading-relaxed">
            Order up to 7 days ahead, pay in full, collect at the front desk timed to your
            training slot. The macros on the app are the food in the box.
          </p>
          <a href="#build" class="inline-flex items-center gap-2 mt-8 text-volt font-semibold hover:gap-3 transition-all">Read the story <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <!-- Screen 02 · BUILD THE BOWL (paper — seam flips to light) -->
      <section id="build" data-accent="#e8a33d" class="bg-surface text-ink min-h-screen relative overflow-hidden px-7 sm:px-10 lg:px-16 py-24">
        <div aria-hidden="true" class="pointer-events-none select-none absolute -left-4 bottom-6 text-outline text-ink/[0.06] font-semibold leading-none" style="font-family: var(--font-display); font-size: clamp(6rem, 13vw, 14rem)">BUILD</div>
        <div class="relative grid lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-center">
          <div class="max-w-lg">
            <h2 class="font-bold text-primary leading-[1.02] mb-2" style="font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem)">Stack the bowl.<br />Watch the macros land.</h2>
            <p class="text-muted mb-8">Add foods and portions — every row weighed. The rings climb to the goal you picked in the console.</p>
            <div class="divide-y divide-hairline border-y border-hairline">
              {ingredients.map((it) => (
                <div class="reveal flex items-center justify-between py-4">
                  <span class="font-semibold text-primary">{it.name}</span>
                  <span class="tabular-nums text-muted text-sm">{it.g}</span>
                </div>
              ))}
            </div>
            <!-- DELTA vs GOAL meter -->
            <div class="mt-8">
              <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-[0.16em] text-muted mb-2">
                <span>Build fit vs goal</span><span class="text-accent-dark" id="deltaVal">Build Muscle</span>
              </div>
              <div class="h-2 rounded-full bg-hairline overflow-hidden">
                <div id="deltaBar" class="h-full rounded-full bg-accent transition-[width] duration-500" style="width:84%"></div>
              </div>
            </div>
          </div>

          <!-- ring cluster -->
          <div class="grid grid-cols-2 gap-5 shrink-0 mx-auto">
            <div class="text-center">
              <div class="macro-ring w-24 h-24 rounded-full grid place-items-center" data-ring="p" style="--p:84%; background: conic-gradient(var(--color-clay) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center font-bold text-clay" style="font-family: var(--font-display)">P</span>
              </div>
              <div class="text-xs font-semibold text-muted mt-2">Protein</div>
            </div>
            <div class="text-center">
              <div class="macro-ring w-24 h-24 rounded-full grid place-items-center" data-ring="c" style="--p:66%; background: conic-gradient(var(--color-honey) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center font-bold text-honey" style="font-family: var(--font-display)">C</span>
              </div>
              <div class="text-xs font-semibold text-muted mt-2">Carbs</div>
            </div>
            <div class="text-center">
              <div class="macro-ring w-24 h-24 rounded-full grid place-items-center" data-ring="f" style="--p:46%; background: conic-gradient(var(--color-teal) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center font-bold text-teal" style="font-family: var(--font-display)">F</span>
              </div>
              <div class="text-xs font-semibold text-muted mt-2">Fat</div>
            </div>
            <div class="text-center">
              <div class="macro-ring w-24 h-24 rounded-full grid place-items-center" data-ring="fbr" style="--p:40%; background: conic-gradient(var(--color-olive) 0 var(--p), var(--color-hairline) 0)">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center font-bold" style="font-family: var(--font-display); color: var(--color-olive)">Fbr</span>
              </div>
              <div class="text-xs font-semibold text-muted mt-2">Fiber</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Marquee seam -->
      <div class="bg-volt text-forest py-2.5 overflow-hidden border-y-2 border-forest/10">
        <div class="flex whitespace-nowrap animate-marquee">
          {[0, 1].map((copy) => (
            <div class="flex items-center shrink-0" aria-hidden={copy === 1 ? "true" : undefined}>
              {marqueeWords.map((m) => (
                <span class="flex items-center text-sm font-bold uppercase tracking-widest px-6">{m}<span class="ml-6 text-forest/40" aria-hidden="true">✦</span></span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Screen 03 · FROM GYM TO PLATE (paper) — departures-board timetable -->
      <section data-accent="#e8a33d" class="bg-surface text-ink relative overflow-hidden px-7 sm:px-10 lg:px-16 py-24">
        <div aria-hidden="true" class="pointer-events-none select-none absolute -right-4 top-6 text-outline text-ink/[0.06] font-semibold leading-none" style="font-family: var(--font-display); font-size: clamp(6rem, 13vw, 14rem)">SLOT</div>
        <div class="relative">
          <h2 class="font-bold text-primary leading-tight mb-10" style="font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem)">From gym to plate</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-hairline border-y border-hairline">
            {timetable.map((t) => (
              <div class="reveal px-4 py-6">
                <div class="text-outline text-ink/70 font-semibold leading-none mb-4" style="font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 4.5rem)">{t.n}</div>
                <div class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted">Action</div>
                <div class="text-sm font-semibold text-primary mb-3">{t.action}</div>
                <div class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted">Detail</div>
                <div class="text-sm text-ink mb-3">{t.detail}</div>
                <div class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted">Time</div>
                <div class="text-sm font-semibold text-accent-dark tabular-nums">{t.time}</div>
              </div>
            ))}
          </div>
          <div class="h-px bg-honey w-full mt-6"></div>
        </div>
      </section>

      <!-- Screen 04 · TRUST, BY THE GRAM (dark — seam flips back) — ledger -->
      <section data-accent="#a7d94b" class="bg-forest text-white relative overflow-hidden px-7 sm:px-10 lg:px-16 py-24">
        <div aria-hidden="true" class="pointer-events-none select-none absolute -right-4 bottom-6 text-outline text-white/[0.05] font-semibold leading-none" style="font-family: var(--font-display); font-size: clamp(6rem, 13vw, 14rem)">WEIGHED</div>
        <div class="relative">
          <h2 class="font-bold leading-[1.05] max-w-2xl mb-10" style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.4rem)">
            The number on the app is the <span class="text-volt">food in the box.</span>
          </h2>
          <div class="border-t-2 border-white/80 max-w-3xl">
            <div class="grid grid-cols-2 text-[10px] font-bold uppercase tracking-[0.16em] text-white/50 py-3 border-b border-white/10">
              <span>You do</span><span>We do</span>
            </div>
            {ledger.map((row) => (
              <div class="reveal grid grid-cols-2 gap-4 py-4 border-b border-white/10 items-baseline">
                <span class="text-white/85 text-sm md:text-base">{row.you}</span>
                <span class="text-white font-semibold text-sm md:text-base">{row.we}</span>
              </div>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-4 mt-6 max-w-3xl">
            <span class="reveal inline-flex items-center gap-1.5 rounded-full bg-honey/15 text-honey px-3 py-1 text-[11px] font-bold">✓ Cancelled → +₹420 credited</span>
            <p class="text-white/45 text-xs">*Wallet credit is usable on orders, not withdrawable.</p>
          </div>
        </div>
      </section>

      <!-- Screen 05 · STRAIGHT ANSWERS (paper) — native details FAQ -->
      <section data-accent="#e8a33d" class="bg-surface text-ink px-7 sm:px-10 lg:px-16 py-24">
        <h2 class="font-bold text-primary leading-tight mb-8" style="font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem)">Straight answers</h2>
        <div class="max-w-2xl">
          {faqs.map((faq) => (
            <details class="group border-b border-hairline py-5">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
