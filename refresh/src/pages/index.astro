     target="_blank" rel="noopener noreferrer"
     class="fixed bottom-24 lg:bottom-6 right-5 z-40 bg-forest hover:bg-primary text-volt w-12 h-12 rounded-xl border border-white/15 flex items-center justify-center shadow-lg transition-all hover:scale-110"
     aria-label="Chat with Refresh on WhatsApp">
    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>

  <script define:vars={{ goals }}>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const byId = Object.fromEntries(goals.map((g) => [g.id, g]));
    const $$ = (s) => Array.from(document.querySelectorAll(s));
    const gw = document.getElementById("goalWord");

    function countUp(el, to) {
      const from = parseInt((el.textContent || "").replace(/\D/g, "")) || 0;
      if (reduce || from === to) { el.textContent = to; return; }
      const t0 = performance.now(), dur = 520;
      function tick(t) {
        const k = Math.min(1, (t - t0) / dur);
        const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        el.textContent = Math.round(from + (to - from) * e);
        if (k < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function flipWord(w) {
      if (!gw) return;
      if (reduce) { gw.textContent = w; return; }
      gw.style.transform = "translateY(-0.55em)";
      gw.style.opacity = "0";
      setTimeout(() => { gw.textContent = w; gw.style.transform = "translateY(0)"; gw.style.opacity = "1"; }, 165);
    }

    function setRing(sel, pct) { $$(sel).forEach((el) => el.style.setProperty("--p", pct + "%")); }

    function apply(g) {
      $$("[data-refresh-meal]").forEach((el) => (el.textContent = g.meal));
      $$("[data-refresh-goal]").forEach((el) => (el.textContent = g.label));
      $$("[data-refresh-p]").forEach((el) => (el.textContent = g.protein));
      $$("[data-refresh-c]").forEach((el) => (el.textContent = g.carbs));
      $$("[data-refresh-f]").forEach((el) => (el.textContent = g.fat));
      $$("[data-refresh-kcal]").forEach((el) => countUp(el, g.kcal));
      setRing('[data-ring="p"]', g.pP);
      setRing('[data-ring="c"]', g.pC);
      setRing('[data-ring="f"]', g.pF);
      setRing('[data-ring="fbr"]', g.pFbr);
      flipWord(g.word);
      const db = document.getElementById("deltaBar"); if (db) db.style.width = g.pP + "%";
      const dv = document.getElementById("deltaVal"); if (dv) dv.textContent = g.label;
      const an = document.getElementById("goalAnnounce"); if (an) an.textContent = `${g.label} selected. ${g.meal}, ${g.kcal} kcal.`;
    }

    const btnActive = ["bg-volt", "text-forest", "border-volt", "font-bold"];
    const btnInactive = ["bg-white/5", "text-white/85", "border-white/15", "font-semibold"];
    const chipActive = ["bg-volt", "text-forest"];
    const chipInactive = ["bg-white/10", "text-white/80"];

    function selectGoal(id) {
      const g = byId[id]; if (!g) return;
      apply(g);
      $$(".goal-btn").forEach((b) => {
        const on = b.dataset.goal === id;
        b.setAttribute("aria-checked", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
        btnActive.forEach((c) => b.classList.toggle(c, on));
        btnInactive.forEach((c) => b.classList.toggle(c, !on));
      });
      $$(".goal-chip").forEach((b) => {
        const on = b.dataset.goal === id;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        chipActive.forEach((c) => b.classList.toggle(c, on));
        chipInactive.forEach((c) => b.classList.toggle(c, !on));
      });
    }

    $$(".goal-btn, .goal-chip").forEach((b) => b.addEventListener("click", () => selectGoal(b.dataset.goal)));

    // Roving-tabindex keyboard nav for the radiogroup
    const rg = document.getElementById("goalFilter");
    if (rg) rg.addEventListener("keydown", (e) => {
      const btns = Array.from(rg.querySelectorAll(".goal-btn"));
      const i = btns.findIndex((b) => b.getAttribute("aria-checked") === "true");
      let n = null;
      if (e.key === "ArrowRight" || e.key === "ArrowDown") n = (i + 1) % btns.length;
      else if (e.key === "ArrowLeft" || e.key === "ArrowUp") n = (i - 1 + btns.length) % btns.length;
      if (n !== null) { e.preventDefault(); selectGoal(btns[n].dataset.goal); btns[n].focus(); }
    });

    // Scroll reveals
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("is-in"); revealIO.unobserve(en.target); } });
    }, { threshold: 0.15 });
    $$(".reveal").forEach((el) => revealIO.observe(el));

    // Per-screen rail accent recolor (deterministic)
    const rail = document.getElementById("rail");
    if (rail) {
      const accIO = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) rail.style.setProperty("--rail-accent", en.target.dataset.accent); });
      }, { threshold: 0.55 });
      $$("[data-accent]").forEach((el) => accIO.observe(el));
    }

    // Hide mobile ticket bar once the closing CTA is in view
    const closeEl = document.getElementById("screen-close");
    const bar = document.getElementById("mobileTicket");
    if (closeEl && bar) new IntersectionObserver((entries) => {
      entries.forEach((en) => bar.classList.toggle("translate-y-full", en.isIntersecting));
    }, { threshold: 0.25 }).observe(closeEl);
  </script>

  <!-- a11y live region for goal changes -->
  <div id="goalAnnounce" aria-live="polite" class="sr-only"></div>
</BaseLayout>
